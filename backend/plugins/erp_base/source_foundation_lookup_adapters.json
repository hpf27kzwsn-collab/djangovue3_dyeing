    "execution_query": "SELECT * FROM (SELECT \r\nNewID() AS ID,\r\n*\r\nFROM \r\n(SELECT \r\nIIF(A.CustomerID='074','本厂采购','客户来纱') AS YarnCategory,\r\nA.ReceSheetNo,\r\nA.CustomerID,\r\nA.ProdID,\r\nA.LotNo,\r\nA.InSheetKind,\r\nA.ColorID,\r\nA.PurchaseOrders,\r\nA.FixedQty,\r\nA.A_A,\r\nA.A_B,\r\nA.Packs-ISNULL(B.TPacks,0.00) AS Packs,\r\nA.Rolls-ISNULL(B.TRolls,0.00)  AS Rolls,\r\nA.LengthQty-ISNULL(B.TLengthQty,0.00)  AS LengthQty,\r\nA.WeightQty-ISNULL(B.TWeightQty,0.00)  AS WeightQty\r\nFROM dye.vwSemiStockBook_New A\r\nLEFT JOIN (\r\nSELECT \r\nISNULL(Semi_Owner,'') AS CustomerID,\r\nISNULL(ProdID,'')ProdID,\r\nISNULL(LotNo,'')LotNo,\r\nISNULL(InSheetKind,'')InSheetKind,\r\nISNULL(ColorID,'')ColorID,\r\nISNULL(PurchaseOrders,'')PurchaseOrders,\r\nISNULL(FixedQty,0.0)FixedQty,\r\nISNULL(A_A,'')A_A,\r\nISNULL(A_B,'')A_B,\r\n0 AS TPacks,\r\nSUM(Rolls)TRolls,\r\n0 AS TLengthQty,\r\nSUM(Qty)AS TWeightQty\r\nFROM dye.CarryMaterialDetail C\r\nWHERE 1=1\r\nAND NOT EXISTS(SELECT 1 FROM dye.SemiOutDetail D WHERE D.JobSheetNo=C.JobSheetNo)\r\nAND EXISTS(SELECT 1 FROM dye.JobSheet J WHERE J.SheetNo=C.JobSheetNo)\r\nGROUP BY Semi_Owner,ProdID,LotNo,InSheetKind,ColorID,PurchaseOrders,FixedQty,A_A,A_B\r\n)B  ON 1=1\r\nAND B.CustomerID = A.CustomerID \r\nAND B.ProdID = A.ProdID\r\nAND B.LotNo = A.LotNo\r\nAND B.InSheetKind = A.InSheetKind\r\nAND B.ColorID = A.ColorID\r\nAND B.PurchaseOrders = A.PurchaseOrders\r\nAND B.FixedQty = A.FixedQty\r\nAND B.A_A = A.A_A \r\nAND B.A_B = A.A_B \r\n)E \r\nWHERE 1=1\r\nAND E.WeightQty>0) original_source WHERE 1=1",
    "adaptation": "原动态拼接产生语法错误或歧义；按完整数据集的外层筛选办理，原查询和原筛选文本均留存。"
