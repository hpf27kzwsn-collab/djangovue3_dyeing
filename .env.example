# 当前脚本直接读取进程环境；本文件用于说明变量，不自动加载。
DJANGO_SECRET_KEY=djangovue3-local-development-signing-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 数据库默认 sqlite；环境变量优先于 database.ini。
DJANGO_DB_ENGINE=sqlite
# DJANGO_DATABASE_CONFIG=H:\客户实例\database.ini
# DJANGO_SQLITE_PATH=db.sqlite3
# 切换 PostgreSQL 时，设置 DJANGO_DB_ENGINE=postgresql 并填写：
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
# DJANGO_DB_NAME=djangovue3
# DJANGO_DB_USER=djangovue3
# DJANGO_DB_PASSWORD=应用账号密码
# DJANGO_DB_SSLMODE=prefer
REDIS_URL=redis://127.0.0.1:6389
